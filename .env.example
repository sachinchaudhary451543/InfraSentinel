# ============================================================================
# PHASE 17: ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your values
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Flask app mode
FLASK_ENV=production
FLASK_APP=web/app.py
FLASK_DEBUG=0

# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secure-random-key-here-change-in-production

# Admin portal secret key
ADMIN_SECRET_KEY=your-admin-secure-key-here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Use PostgreSQL in production (already configured in docker-compose)
DATABASE_URL=postgresql://monitor_user:monitor_password@db:5432/servermonitor

# Or SQLite for development
# DATABASE_URL=sqlite:///./data/servermonitor.db

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Server URL for agents to connect to
SERVER_URL=http://localhost:8080

# Agent communication settings
AGENT_KEY_PREFIX=agent_key_
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF=2.0
REQUEST_TIMEOUT=10
COMMAND_TIMEOUT=60

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL=30

# Metrics collection interval (seconds)
METRICS_INTERVAL=30

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Require HTTPS (set to true in production)
REQUIRE_HTTPS=false

# Verify SSL certificates
VERIFY_SSL=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:8080

# Rate limiting - format: "requests per time_period"
RATE_LIMIT_GLOBAL=200/day,50/hour
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute
RATE_LIMIT_AGENT_METRICS=600/hour

# ============================================================================
# SMTP CONFIGURATION (for email alerts)
# ============================================================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=monitoring@yourdomain.com

# Enable email alerts
ENABLE_EMAIL_ALERTS=false

# Alert recipient emails (comma-separated)
ALERT_EMAIL_RECIPIENTS=admin@yourdomain.com,ops@yourdomain.com

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# Sentry error tracking (optional)
SENTRY_DSN=

# Azure configuration (if using Azure discovery)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# SharePoint configuration (if using SharePoint integration)
SHAREPOINT_SITE_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output paths
LOG_DIR=./logs
AGENT_LOG_FILE=./logs/agent.log
APP_LOG_FILE=./logs/app.log
WORKER_LOG_FILE=./logs/worker.log

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Database connection pool size
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis connection pool
REDIS_POOL_SIZE=10

# Worker settings
WORKER_CONCURRENCY=4
WORKER_TIMEOUT=300

# Metrics retention (days)
METRICS_RETENTION_DAYS=30

# Alert retention (days)
ALERT_RETENTION_DAYS=90

# ============================================================================
# DOCKER-COMPOSE SERVICES
# ============================================================================

# PostgreSQL
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=monitor_password
POSTGRES_DB=servermonitor

# These match docker-compose.yml - update if needed
DB_HOST=db
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# HTTPS/SSL CONFIGURATION (Let's Encrypt Ready)
# ============================================================================

# Domain name (for SSL certificate)
DOMAIN_NAME=monitoring.yourdomain.com

# Enable automatic HTTPS redirect
HTTPS_REDIRECT=false

# SSL certificate paths (for production with real certificates)
SSL_CERT_PATH=/etc/letsencrypt/live/monitoring.yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/monitoring.yourdomain.com/privkey.pem
